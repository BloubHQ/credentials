# The tools that assemble and measure the enclave image file: `nitro-cli` and the files it puts
# into every EIF (kernel, kernel command line, init, the NSM driver, linuxkit). build/build.sh
# runs this image with the socket of the Docker daemon and calls
#
#   nitro-cli build-enclave --docker-uri <enclave image> --output-file enclave.eif
#   nitro-cli describe-eif --eif-path enclave.eif
#
# Adapted from pickle-com/credential-enclave (builder/Dockerfile.eif, Apache-2.0).
#
# The base image is fixed by digest. An Amazon Linux 2023 image reads packages from the
# repository version it was released with, so the packages below, fixed by name, version and
# release, and everything they depend on are the same in every build. build.sh records the
# SHA-256 of the kernel, the command line, init, the NSM driver and linuxkit in
# measurements.json.
FROM amazonlinux:2023@sha256:5b29412077a463b4a3a8fbc99a8cdf4b929f38a3ecc8dac10328d8f36b0099b8

RUN dnf install -y --setopt=install_weak_deps=False \
        aws-nitro-enclaves-cli-1.5.0-0.amzn2023 \
        aws-nitro-enclaves-cli-devel-1.5.0-0.amzn2023 \
        jq-1.8.1-60.amzn2023 \
    && dnf clean all \
    && nitro-cli --version
